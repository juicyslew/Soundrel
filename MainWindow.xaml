<Window x:Class="Soundrel.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:Soundrel.ViewModels"
        mc:Ignorable="d"
        Title="Soundrel"
        Width="1380"
        Height="820"
        MinWidth="1080"
        MinHeight="680"
        Background="#11151B"
         Foreground="#E8EDF2"
         FontFamily="Segoe UI"
         Loaded="Window_Loaded"
         Closing="Window_Closing">
    <Window.Resources>
        <SolidColorBrush x:Key="PanelBrush" Color="#1A2029" />
        <SolidColorBrush x:Key="PanelBorderBrush" Color="#303A48" />
        <SolidColorBrush x:Key="MutedBrush" Color="#98A5B5" />
        <SolidColorBrush x:Key="AccentBrush" Color="#4FC3A1" />

        <Style x:Key="PanelStyle" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource PanelBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource PanelBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="7" />
            <Setter Property="Padding" Value="16" />
        </Style>

        <Style x:Key="SectionTitleStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="18" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="#F6F8FA" />
            <Setter Property="Margin" Value="0,0,0,12" />
        </Style>

        <Style x:Key="MutedTextStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource MutedBrush}" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>

        <Style x:Key="ActionButtonStyle" TargetType="Button">
            <Setter Property="MinHeight" Value="36" />
            <Setter Property="Padding" Value="14,7" />
            <Setter Property="Margin" Value="0,0,8,0" />
            <Setter Property="Background" Value="#293342" />
            <Setter Property="Foreground" Value="#F6F8FA" />
            <Setter Property="BorderBrush" Value="#465469" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#344154" />
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Opacity" Value="0.58" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="PlayNowButtonStyle" TargetType="Button" BasedOn="{StaticResource ActionButtonStyle}">
            <Setter Property="Background" Value="#176B57" />
            <Setter Property="BorderBrush" Value="#4FC3A1" />
        </Style>

        <Style x:Key="AfterCurrentButtonStyle" TargetType="Button" BasedOn="{StaticResource ActionButtonStyle}">
            <Setter Property="Background" Value="#604B1B" />
            <Setter Property="BorderBrush" Value="#D1A947" />
        </Style>

        <Style x:Key="HardCutChoiceButtonStyle" TargetType="Button" BasedOn="{StaticResource ActionButtonStyle}">
            <Setter Property="Background" Value="#24352F" />
            <Setter Property="BorderBrush" Value="#426453" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding DataContext.IsHardCutSelected, RelativeSource={RelativeSource AncestorType={x:Type Window}}}" Value="True">
                    <Setter Property="Background" Value="#176B57" />
                    <Setter Property="BorderBrush" Value="#78E0BE" />
                    <Setter Property="BorderThickness" Value="2" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="CrossfadeChoiceButtonStyle" TargetType="Button" BasedOn="{StaticResource ActionButtonStyle}">
            <Setter Property="Background" Value="#263447" />
            <Setter Property="BorderBrush" Value="#4D6F91" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding DataContext.IsCrossfadeSelected, RelativeSource={RelativeSource AncestorType={x:Type Window}}}" Value="True">
                    <Setter Property="Background" Value="#24577D" />
                    <Setter Property="BorderBrush" Value="#9BD0FF" />
                    <Setter Property="BorderThickness" Value="2" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="MasterFadeButtonStyle" TargetType="Button" BasedOn="{StaticResource ActionButtonStyle}">
            <Setter Property="Background" Value="#253A46" />
            <Setter Property="BorderBrush" Value="#6A9BB5" />
        </Style>

        <Style TargetType="ListBox">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="#E8EDF2" />
            <Setter Property="BorderThickness" Value="0" />
        </Style>

        <Style TargetType="TreeView">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="#E8EDF2" />
            <Setter Property="BorderThickness" Value="0" />
        </Style>

        <Style TargetType="TreeViewItem">
            <Setter Property="Foreground" Value="#E8EDF2" />
        </Style>

        <HierarchicalDataTemplate DataType="{x:Type vm:LibraryTreeNode}"
                                  ItemsSource="{Binding Children}">
            <Border x:Name="NodeBorder" Padding="4,3" CornerRadius="3">
                <TextBlock x:Name="NodeName" Text="{Binding Name}" FontSize="14" Foreground="#E8EDF2" />
            </Border>
            <HierarchicalDataTemplate.Triggers>
                <DataTrigger Binding="{Binding IsPlaylist}" Value="False">
                    <Setter TargetName="NodeName" Property="FontWeight" Value="SemiBold" />
                    <Setter TargetName="NodeName" Property="Foreground" Value="#AFC5DB" />
                </DataTrigger>
                <DataTrigger Binding="{Binding IsPlaylist}" Value="True">
                    <Setter TargetName="NodeBorder" Property="Margin" Value="4,0,0,0" />
                </DataTrigger>
            </HierarchicalDataTemplate.Triggers>
        </HierarchicalDataTemplate>
    </Window.Resources>

    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Style="{StaticResource PanelStyle}" Padding="14" Margin="0,0,0,12">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Row="0" Grid.Column="0" Margin="0,0,14,0" VerticalAlignment="Center">
                    <TextBlock Text="SOUNDREL" FontSize="18" FontWeight="Bold" Foreground="{StaticResource AccentBrush}" />
                    <TextBlock Text="Local sound library" Style="{StaticResource MutedTextStyle}" FontSize="11" />
                </StackPanel>
                <Border Grid.Row="0" Grid.Column="1" Background="#11151B" BorderBrush="#303A48" BorderThickness="1"
                        CornerRadius="4" Padding="10,7" Margin="0,0,12,0" VerticalAlignment="Center">
                    <TextBlock Text="{Binding LibraryPathDisplay}" TextTrimming="CharacterEllipsis"
                               ToolTip="{Binding SelectedLibraryPath}" />
                </Border>
                <Button Grid.Row="0" Grid.Column="2" Content="Browse..." Style="{StaticResource ActionButtonStyle}"
                        IsEnabled="{Binding IsNotBusy}" Click="Browse_Click" />
                <Button Grid.Row="0" Grid.Column="3" Content="Rescan" Style="{StaticResource ActionButtonStyle}"
                        Margin="0" IsEnabled="{Binding CanRescan}" Click="Rescan_Click" />

                <Border Grid.Row="1" Grid.ColumnSpan="4" CornerRadius="4" Padding="10,7" Margin="0,10,0,0"
                        MaxHeight="76" ToolTip="{Binding StatusText}"
                        AutomationProperties.Name="Library status">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="Background" Value="#14251F" />
                            <Setter Property="BorderBrush" Value="#2D6E5B" />
                            <Setter Property="BorderThickness" Value="1" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding HasScanIssues}" Value="True">
                                    <Setter Property="Background" Value="#382326" />
                                    <Setter Property="BorderBrush" Value="#A55762" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <DockPanel LastChildFill="True">
                        <TextBlock DockPanel.Dock="Left" Text="STATUS" FontSize="11" FontWeight="Bold"
                                   Foreground="{StaticResource AccentBrush}" Margin="0,1,12,0" />
                        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                            <TextBlock Text="{Binding StatusText}" TextWrapping="Wrap"
                                       AutomationProperties.LiveSetting="Polite" />
                        </ScrollViewer>
                    </DockPanel>
                </Border>
            </Grid>
        </Border>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="3*" MinWidth="250" />
                <ColumnDefinition Width="5*" MinWidth="390" />
                <ColumnDefinition Width="4*" MinWidth="320" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Style="{StaticResource PanelStyle}" Margin="0,0,12,0">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Top">
                        <TextBlock Text="Library" Style="{StaticResource SectionTitleStyle}" />
                        <TextBlock Text="Groups are bold. Select a playlist to see its tracks."
                                   Style="{StaticResource MutedTextStyle}" Margin="0,0,0,10" />
                    </StackPanel>
                    <TreeView ItemsSource="{Binding LibraryNodes}"
                              SelectedItemChanged="LibraryTree_SelectedItemChanged" />
                </DockPanel>
            </Border>

            <Border Grid.Column="1" Style="{StaticResource PanelStyle}" Margin="0,0,12,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <StackPanel Grid.Row="0">
                        <TextBlock Text="Selected Playlist" Style="{StaticResource MutedTextStyle}" FontSize="12" />
                        <TextBlock Text="{Binding SelectedPlaylistName}" FontSize="24" FontWeight="SemiBold" Foreground="#F6F8FA"
                                   TextTrimming="CharacterEllipsis" Margin="0,2,0,12" />
                     </StackPanel>
                    <StackPanel Grid.Row="1" Margin="0,0,0,14">
                        <TextBlock Text="Immediate transition" FontWeight="SemiBold" Foreground="#F6F8FA" />
                        <TextBlock Text="Choose how Play Now switches playlists. Crossfade is fixed at 2 seconds."
                                   Style="{StaticResource MutedTextStyle}" FontSize="11" Margin="0,2,0,7" />
                        <WrapPanel>
                            <Button Content="Hard Cut" Style="{StaticResource HardCutChoiceButtonStyle}"
                                    Click="HardCut_Click"
                                    AutomationProperties.Name="Immediate transition: Hard Cut"
                                    AutomationProperties.HelpText="Select Hard Cut for an immediate playlist change without overlap." />
                            <Button Content="Crossfade" Style="{StaticResource CrossfadeChoiceButtonStyle}"
                                    Click="Crossfade_Click"
                                    AutomationProperties.Name="Immediate transition: Crossfade"
                                    AutomationProperties.HelpText="Select Crossfade for a fixed 2-second immediate transition." />
                        </WrapPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                            <Button Content="{Binding PlayNowLabel}" Style="{StaticResource PlayNowButtonStyle}"
                                    IsEnabled="{Binding CanPlayNow}" Click="PlayNow_Click"
                                    AutomationProperties.Name="Play Now" />
                            <Button Content="After Current" Style="{StaticResource AfterCurrentButtonStyle}"
                                    IsEnabled="{Binding CanPlayAfterCurrent}" Click="AfterCurrent_Click" />
                        </StackPanel>
                    </StackPanel>
                    <ListBox Grid.Row="2" ItemsSource="{Binding SelectedTracks}" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                <Setter Property="Padding" Value="0" />
                                <Setter Property="Margin" Value="0,0,0,6" />
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Border Background="#222A35" BorderBrush="#303A48" BorderThickness="1"
                                        CornerRadius="4" Padding="10,7">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                         <TextBlock Grid.Column="0" Text="{Binding Name}" FontSize="14"
                                                    VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                                                    ToolTip="{Binding FilePath}" Foreground="#E8EDF2" />
                                         <Button Grid.Column="1" Content="Queue"
                                                 IsEnabled="{Binding DataContext.CanQueueTrack, RelativeSource={RelativeSource AncestorType=Window}}"
                                                 Click="QueueTrack_Click"
                                                 Style="{StaticResource ActionButtonStyle}" MinHeight="30"
                                                 Padding="10,4" Margin="12,0,0,0" />
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
            </Border>

            <Border Grid.Column="2" Style="{StaticResource PanelStyle}">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel>
                         <TextBlock Text="Session" Style="{StaticResource SectionTitleStyle}" />
                         <Grid Margin="0,0,0,16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                  <RowDefinition Height="Auto" />
                                  <RowDefinition Height="Auto" />
                                  <RowDefinition Height="Auto" />
                                  <RowDefinition Height="Auto" />
                                  <RowDefinition Height="Auto" />
                                  <RowDefinition Height="Auto" />
                                  <RowDefinition Height="Auto" />
                                  <RowDefinition Height="Auto" />
                                  <RowDefinition Height="Auto" />
                                  <RowDefinition Height="Auto" />
                             </Grid.RowDefinitions>
                             <TextBlock Grid.Row="0" Grid.Column="0" Text="Now playing" Foreground="{StaticResource MutedBrush}" Margin="0,0,12,6" />
                             <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding CurrentTrackDisplayName}"
                                        Foreground="#F6F8FA" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"
                                        ToolTip="{Binding CurrentTrack.FilePath}" Margin="0,0,0,6" />
                             <TextBlock Grid.Row="1" Grid.Column="0" Text="File" Foreground="{StaticResource MutedBrush}" Margin="0,0,12,6" />
                             <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding CurrentFileName}" Foreground="#E8EDF2"
                                        TextTrimming="CharacterEllipsis" ToolTip="{Binding CurrentTrack.FilePath}" Margin="0,0,0,6" />
                             <TextBlock Grid.Row="2" Grid.Column="0" Text="Current playlist" Foreground="{StaticResource MutedBrush}" Margin="0,0,12,6" />
                             <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding CurrentPlaylistDisplay}" Foreground="#E8EDF2" Margin="0,0,0,6" />
                             <TextBlock Grid.Row="3" Grid.Column="0" Text="Active playlist" Foreground="{StaticResource MutedBrush}" Margin="0,0,12,6" />
                             <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding ActivePlaylistDisplay}" Foreground="#E8EDF2" Margin="0,0,0,6" />
                             <TextBlock Grid.Row="4" Grid.Column="0" Text="Pending playlist" Foreground="{StaticResource MutedBrush}" Margin="0,0,12,6" />
                             <TextBlock Grid.Row="4" Grid.Column="1" Text="{Binding PendingPlaylistDisplay}" Foreground="#E8EDF2" Margin="0,0,0,6" />
                             <TextBlock Grid.Row="5" Grid.Column="0" Text="State" Foreground="{StaticResource MutedBrush}" Margin="0,0,12,6" />
                             <TextBlock Grid.Row="5" Grid.Column="1" Text="{Binding PlaybackStateDisplay}" Foreground="#E8EDF2" Margin="0,0,0,6" />
                              <TextBlock Grid.Row="6" Grid.Column="0" Text="Elapsed / duration" Foreground="{StaticResource MutedBrush}" Margin="0,0,12,0" />
                              <TextBlock Grid.Row="6" Grid.Column="1" Text="{Binding ProgressDisplay}" Foreground="#E8EDF2" />
                              <TextBlock Grid.Row="7" Grid.Column="0" Text="Immediate mode" Foreground="{StaticResource MutedBrush}" Margin="0,6,12,0" />
                              <TextBlock Grid.Row="7" Grid.Column="1" Text="{Binding PreferredImmediateTransitionMode}" Foreground="#E8EDF2" Margin="0,6,0,0"
                                         ToolTip="The selected mode used by Play Now." />
                              <TextBlock Grid.Row="8" Grid.Column="0" Text="Master output fade gain" Foreground="{StaticResource MutedBrush}" Margin="0,6,12,0" />
                              <TextBlock Grid.Row="8" Grid.Column="1" Text="{Binding MasterGainDisplay}" Foreground="#E8EDF2" Margin="0,6,0,0"
                                         ToolTip="Observed master output fade gain percentage; this is not the configured master volume." />
                              <TextBlock Grid.Row="9" Grid.Column="0" Text="Master fade state" Foreground="{StaticResource MutedBrush}" Margin="0,6,12,0" />
                              <TextBlock Grid.Row="9" Grid.Column="1" Text="{Binding MasterFadeStateDisplay}" Foreground="#E8EDF2" Margin="0,6,0,0"
                                         ToolTip="Current state of the fixed-duration master output fade." />
                          </Grid>

                         <Border Background="#382326" BorderBrush="#A55762" BorderThickness="1"
                                 CornerRadius="4" Padding="10" Margin="0,0,0,14"
                                 AutomationProperties.LiveSetting="Assertive">
                             <Border.Style>
                                 <Style TargetType="Border">
                                     <Setter Property="Visibility" Value="Collapsed" />
                                     <Style.Triggers>
                                         <DataTrigger Binding="{Binding HasPlaybackError}" Value="True">
                                             <Setter Property="Visibility" Value="Visible" />
                                         </DataTrigger>
                                     </Style.Triggers>
                                 </Style>
                             </Border.Style>
                             <StackPanel>
                                 <TextBlock Text="PLAYBACK ERROR" Foreground="#FFBBC1" FontSize="11" FontWeight="Bold" Margin="0,0,0,4" />
                                 <TextBlock Text="{Binding LatestPlaybackErrorDisplay}" Foreground="#FFDDE0" TextWrapping="Wrap" />
                             </StackPanel>
                         </Border>

                         <TextBlock Text="Explicit Queue (FIFO)" FontWeight="SemiBold" Foreground="#F6F8FA" Margin="0,0,0,8" />
                         <TextBlock Text="Empty" Margin="0,0,0,14">
                             <TextBlock.Style>
                                 <Style TargetType="TextBlock" BasedOn="{StaticResource MutedTextStyle}">
                                     <Style.Triggers>
                                         <DataTrigger Binding="{Binding HasExplicitQueue}" Value="True">
                                             <Setter Property="Visibility" Value="Collapsed" />
                                         </DataTrigger>
                                     </Style.Triggers>
                                 </Style>
                             </TextBlock.Style>
                         </TextBlock>
                         <ItemsControl ItemsSource="{Binding ExplicitQueue}" Margin="0,0,0,14">
                             <ItemsControl.ItemTemplate>
                                 <DataTemplate>
                                     <Border Background="#222A35" BorderBrush="#303A48" BorderThickness="1"
                                             CornerRadius="4" Padding="9,7" Margin="0,0,0,6">
                                         <StackPanel>
                                             <TextBlock Text="{Binding Track.Name}" Foreground="#E8EDF2" FontWeight="SemiBold"
                                                        TextTrimming="CharacterEllipsis" ToolTip="{Binding Track.FilePath}" />
                                             <TextBlock Text="{Binding SourcePlaylist.Name, StringFormat=From {0}}"
                                                        Foreground="{StaticResource MutedBrush}" FontSize="11" />
                                         </StackPanel>
                                     </Border>
                                 </DataTemplate>
                             </ItemsControl.ItemTemplate>
                         </ItemsControl>

                         <Separator Background="#303A48" Margin="0,0,0,14" />
                         <TextBlock Text="Ambience" Style="{StaticResource SectionTitleStyle}" />
                         <TextBlock Text="Each source loops independently. Play and Stop use a fixed, sample-counted 2-second fade. Play remains available during Fading Out to reverse smoothly."
                                    Style="{StaticResource MutedTextStyle}" Margin="0,0,0,8" />
                         <ItemsControl ItemsSource="{Binding AmbienceTracks}" Margin="0,0,0,16">
                             <ItemsControl.ItemTemplate>
                                 <DataTemplate>
                                     <Border Background="#222A35" BorderBrush="#303A48" BorderThickness="1"
                                             CornerRadius="4" Padding="8,7" Margin="0,0,0,6">
                                         <Grid>
                                             <Grid.RowDefinitions>
                                                 <RowDefinition Height="Auto" />
                                                 <RowDefinition Height="Auto" />
                                             </Grid.RowDefinitions>
                                             <Grid.ColumnDefinitions>
                                                 <ColumnDefinition Width="*" />
                                                 <ColumnDefinition Width="Auto" />
                                                 <ColumnDefinition Width="Auto" />
                                                 <ColumnDefinition Width="Auto" />
                                             </Grid.ColumnDefinitions>
                                             <TextBlock Grid.Row="0" Grid.Column="0" Text="{Binding Name}"
                                                        TextTrimming="CharacterEllipsis" ToolTip="{Binding FilePath}"
                                                        Foreground="#E8EDF2" FontWeight="SemiBold" />
                                             <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding PlaybackStateLabel}"
                                                        Foreground="{StaticResource MutedBrush}" Margin="8,0,8,0"
                                                        VerticalAlignment="Center" />
                                             <Button Grid.Row="0" Grid.Column="2" Content="Play"
                                                     Style="{StaticResource PlayNowButtonStyle}" MinHeight="30"
                                                     Padding="9,4" Margin="0,0,5,0" IsEnabled="{Binding CanPlay}"
                                                     Click="AmbiencePlay_Click" ToolTip="Play this looping ambience source."
                                                      AutomationProperties.Name="{Binding Name, StringFormat=Play ambience: {0}}"
                                                     AutomationProperties.HelpText="Play this ambience source with its fixed 2-second fade." />
                                             <Button Grid.Row="0" Grid.Column="3" Content="Stop"
                                                     Style="{StaticResource ActionButtonStyle}" MinHeight="30"
                                                     Padding="9,4" Margin="0" IsEnabled="{Binding CanStop}"
                                                     Click="AmbienceStop_Click" ToolTip="Stop this ambience source."
                                                      AutomationProperties.Name="{Binding Name, StringFormat=Stop ambience: {0}}"
                                                     AutomationProperties.HelpText="Stop this ambience source with its fixed 2-second fade." />
                                             <Slider Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="3"
                                                     Minimum="0" Maximum="1" TickFrequency="0.1"
                                                     IsSnapToTickEnabled="False" Margin="0,7,8,0"
                                                     Value="{Binding Gain, Mode=OneWay}"
                                                     PreviewMouseLeftButtonUp="AmbienceGainSlider_MouseLeftButtonUp"
                                                     PreviewKeyUp="AmbienceGainSlider_KeyUp"
                                                     ToolTip="Individual ambience gain, 0 to 100 percent."
                                                     AutomationProperties.Name="{Binding Name, StringFormat=Gain for ambience: {0}}"
                                                     AutomationProperties.HelpText="Adjust this source from 0 to 100 percent. The value is submitted when mouse or keyboard adjustment ends." />
                                             <TextBlock Grid.Row="1" Grid.Column="3" Text="{Binding GainDisplay}"
                                                        Foreground="#F6F8FA" FontWeight="SemiBold"
                                                        HorizontalAlignment="Right" VerticalAlignment="Center"
                                                        Margin="0,7,0,0" />
                                         </Grid>
                                     </Border>
                                 </DataTemplate>
                             </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <Separator Background="#303A48" Margin="0,0,0,14" />
                        <TextBlock Text="In-App Scan Details" Style="{StaticResource SectionTitleStyle}" />
                        <TextBlock Text="Scan errors and paths appear here in Soundrel; no terminal is required."
                                   Style="{StaticResource MutedTextStyle}" Margin="0,0,0,8" />
                        <Border Background="#121820" BorderBrush="#303A48" BorderThickness="1" CornerRadius="4"
                                Padding="10" Margin="0,0,0,9">
                            <TextBlock Text="{Binding StatusText}" TextWrapping="Wrap" />
                        </Border>
                        <ItemsControl ItemsSource="{Binding ScanIssues}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="#382326" BorderBrush="#75424A" BorderThickness="1"
                                            CornerRadius="4" Padding="9" Margin="0,0,0,7">
                                        <StackPanel>
                                            <TextBlock Text="{Binding Message}" TextWrapping="Wrap" Foreground="#FFD1D5" />
                                            <TextBlock Text="{Binding Path}" TextWrapping="Wrap" Foreground="#BFA7AA"
                                                       FontSize="11" Margin="0,3,0,0" />
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>

        <Border Grid.Row="2" Style="{StaticResource PanelStyle}" Padding="12" Margin="0,12,0,0">
             <Grid>
                  <Grid.RowDefinitions>
                      <RowDefinition Height="Auto" />
                      <RowDefinition Height="Auto" />
                      <RowDefinition Height="Auto" />
                  </Grid.RowDefinitions>
                 <Grid.ColumnDefinitions>
                     <ColumnDefinition Width="Auto" />
                     <ColumnDefinition Width="*" />
                     <ColumnDefinition Width="Auto" />
                 </Grid.ColumnDefinitions>
                 <TextBlock Grid.Row="0" Grid.Column="0" Text="TRANSPORT" FontWeight="Bold" Foreground="{StaticResource AccentBrush}"
                            VerticalAlignment="Center" Margin="2,0,18,0" />
                  <StackPanel Grid.Row="0" Grid.Column="1" Orientation="Horizontal">
                      <Button Content="{Binding PauseResumeLabel}" Style="{StaticResource ActionButtonStyle}"
                              IsEnabled="{Binding CanPauseResume}" Click="PauseResume_Click"
                              ToolTip="Pause or resume music transport only; ambience sources continue independently."
                              AutomationProperties.Name="Music pause or resume"
                              AutomationProperties.HelpText="Pause or resume the music transport. Ambience is controlled separately." />
                     <Button Content="Skip" Style="{StaticResource ActionButtonStyle}"
                             IsEnabled="{Binding CanSkip}" Click="Skip_Click" />
                     <Button Content="Clear Queue" Style="{StaticResource ActionButtonStyle}"
                             IsEnabled="{Binding CanClearQueue}" Click="ClearQueue_Click" />
                       <Button Content="Stop All" Style="{StaticResource ActionButtonStyle}"
                              IsEnabled="{Binding CanStopAll}" Click="StopAll_Click"
                              ToolTip="Global stop: stop music and every ambience source."
                              AutomationProperties.Name="Stop all music and ambience"
                              AutomationProperties.HelpText="Stop all music and ambience sources globally." />
                  </StackPanel>
                  <StackPanel Grid.Row="0" Grid.Column="2" VerticalAlignment="Center">
                      <TextBlock Text="{Binding PlaybackStateDisplay}" Foreground="#F6F8FA" FontWeight="SemiBold"
                                 HorizontalAlignment="Right" />
                      <TextBlock Text="{Binding ProgressDisplay}" Style="{StaticResource MutedTextStyle}"
                                 HorizontalAlignment="Right" />
                  </StackPanel>

                  <Border Grid.Row="1" Grid.ColumnSpan="3" BorderBrush="#303A48" BorderThickness="0,1,0,0"
                          Padding="0,10,0,0" Margin="0,10,0,0">
                     <WrapPanel>
                         <StackPanel Width="205" VerticalAlignment="Center" Margin="2,0,10,0">
                             <TextBlock Text="MASTER FADES" FontWeight="Bold" Foreground="#9BD0FF" />
                             <TextBlock Text="Fixed 2s / 10s output fades; not track transitions."
                                        Style="{StaticResource MutedTextStyle}" FontSize="11" />
                         </StackPanel>
                         <Button Content="Quick Fade In (2s)" Style="{StaticResource MasterFadeButtonStyle}"
                                 IsEnabled="{Binding CanQuickFadeIn}" Click="QuickFadeIn_Click"
                                 AutomationProperties.Name="Quick master fade in, 2 seconds"
                                 AutomationProperties.HelpText="Fade the master output in over the fixed 2-second duration." />
                         <Button Content="Quick Fade Out (2s)" Style="{StaticResource MasterFadeButtonStyle}"
                                 IsEnabled="{Binding CanQuickFadeOut}" Click="QuickFadeOut_Click"
                                 AutomationProperties.Name="Quick master fade out, 2 seconds"
                                 AutomationProperties.HelpText="Fade the master output out over the fixed 2-second duration." />
                         <Button Content="Slow Fade In (10s)" Style="{StaticResource MasterFadeButtonStyle}"
                                 IsEnabled="{Binding CanSlowFadeIn}" Click="SlowFadeIn_Click"
                                 AutomationProperties.Name="Slow master fade in, 10 seconds"
                                 AutomationProperties.HelpText="Fade the master output in over the fixed 10-second duration." />
                         <Button Content="Slow Fade Out (10s)" Style="{StaticResource MasterFadeButtonStyle}"
                                 IsEnabled="{Binding CanSlowFadeOut}" Click="SlowFadeOut_Click"
                                 AutomationProperties.Name="Slow master fade out, 10 seconds"
                                 AutomationProperties.HelpText="Fade the master output out over the fixed 10-second duration." />
                     </WrapPanel>
                  </Border>

                  <Border Grid.Row="2" Grid.ColumnSpan="3" BorderBrush="#303A48" BorderThickness="0,1,0,0"
                          Padding="0,10,0,0" Margin="0,10,0,0">
                      <Grid>
                          <Grid.ColumnDefinitions>
                              <ColumnDefinition Width="*" />
                              <ColumnDefinition Width="*" />
                              <ColumnDefinition Width="*" />
                          </Grid.ColumnDefinitions>
                          <StackPanel Grid.Column="0" Margin="2,0,14,0">
                              <TextBlock Text="MUSIC VOLUME" FontWeight="Bold" Foreground="#F6F8FA" />
                              <DockPanel Margin="0,3,0,0">
                                  <TextBlock DockPanel.Dock="Right" Text="{Binding MusicVolumeDisplay}"
                                             Foreground="#F6F8FA" FontWeight="SemiBold" Margin="8,0,0,0" />
                                  <Slider Minimum="0" Maximum="1" TickFrequency="0.1" IsSnapToTickEnabled="False"
                                          Value="{Binding MusicVolume, Mode=OneWay}"
                                          PreviewMouseLeftButtonUp="MusicVolumeSlider_MouseLeftButtonUp"
                                          PreviewKeyUp="MusicVolumeSlider_KeyUp"
                                          ToolTip="Configured music bus volume, 0 to 100 percent."
                                          AutomationProperties.Name="Music volume"
                                          AutomationProperties.HelpText="Adjust the persistent music bus volume from 0 to 100 percent. The value is submitted when mouse or keyboard adjustment ends." />
                              </DockPanel>
                          </StackPanel>
                          <StackPanel Grid.Column="1" Margin="0,0,14,0">
                              <TextBlock Text="AMBIENCE VOLUME" FontWeight="Bold" Foreground="#F6F8FA" />
                              <DockPanel Margin="0,3,0,0">
                                  <TextBlock DockPanel.Dock="Right" Text="{Binding AmbienceVolumeDisplay}"
                                             Foreground="#F6F8FA" FontWeight="SemiBold" Margin="8,0,0,0" />
                                  <Slider Minimum="0" Maximum="1" TickFrequency="0.1" IsSnapToTickEnabled="False"
                                          Value="{Binding AmbienceVolume, Mode=OneWay}"
                                          PreviewMouseLeftButtonUp="AmbienceVolumeSlider_MouseLeftButtonUp"
                                          PreviewKeyUp="AmbienceVolumeSlider_KeyUp"
                                          ToolTip="Configured ambience bus volume, 0 to 100 percent."
                                          AutomationProperties.Name="Ambience volume"
                                          AutomationProperties.HelpText="Adjust the persistent ambience bus volume from 0 to 100 percent. The value is submitted when mouse or keyboard adjustment ends." />
                              </DockPanel>
                          </StackPanel>
                          <StackPanel Grid.Column="2">
                              <TextBlock Text="MASTER VOLUME" FontWeight="Bold" Foreground="#F6F8FA" />
                              <DockPanel Margin="0,3,0,0">
                                  <TextBlock DockPanel.Dock="Right" Text="{Binding MasterVolumeDisplay}"
                                             Foreground="#F6F8FA" FontWeight="SemiBold" Margin="8,0,0,0" />
                                  <Slider Minimum="0" Maximum="1" TickFrequency="0.1" IsSnapToTickEnabled="False"
                                          Value="{Binding MasterVolume, Mode=OneWay}"
                                          PreviewMouseLeftButtonUp="MasterVolumeSlider_MouseLeftButtonUp"
                                          PreviewKeyUp="MasterVolumeSlider_KeyUp"
                                          ToolTip="Configured master volume, 0 to 100 percent. This is separate from the master output fade."
                                          AutomationProperties.Name="Master volume"
                                          AutomationProperties.HelpText="Adjust the persistent master volume from 0 to 100 percent. This is separate from the master output fade gain." />
                              </DockPanel>
                          </StackPanel>
                      </Grid>
                  </Border>
               </Grid>
         </Border>
    </Grid>
</Window>
